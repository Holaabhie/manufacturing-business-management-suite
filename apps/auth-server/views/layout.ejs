<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Manufacturing Business Management Suite — Secure Portal" />
  <title><%= typeof title !== 'undefined' ? title + ' · Auth Server' : 'Auth Server' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    /* ── Reset & Base ────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:          #0f1117;
      --bg-card:     #181b23;
      --bg-nav:      #14161e;
      --border:      #2a2d38;
      --text:        #e4e6ee;
      --text-muted:  #8b8fa3;
      --accent:      #6366f1;
      --accent-hover:#818cf8;
      --danger:      #f43f5e;
      --success:     #10b981;
      --warning:     #f59e0b;
      --radius:      10px;
      --shadow:      0 4px 24px rgba(0,0,0,.35);
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    a { color: var(--accent); text-decoration: none; transition: color .15s; }
    a:hover { color: var(--accent-hover); }

    /* ── Navigation ──────────────────────────────── */
    .nav {
      background: var(--bg-nav);
      border-bottom: 1px solid var(--border);
      padding: 0 2rem;
      display: flex;
      align-items: center;
      height: 60px;
      backdrop-filter: blur(8px);
    }
    .nav__brand {
      font-weight: 700;
      font-size: 1.15rem;
      letter-spacing: -.02em;
      background: linear-gradient(135deg, var(--accent), #a78bfa);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .nav__links {
      display: flex;
      gap: 1.25rem;
      margin-left: 2.5rem;
      list-style: none;
    }
    .nav__links a {
      color: var(--text-muted);
      font-size: .9rem;
      font-weight: 500;
      padding: .35rem 0;
      border-bottom: 2px solid transparent;
      transition: color .15s, border-color .15s;
    }
    .nav__links a.active,
    .nav__links a:hover {
      color: var(--text);
      border-color: var(--accent);
    }
    .nav__right { margin-left: auto; display: flex; align-items: center; gap: 1rem; }
    .nav__user {
      font-size: .85rem;
      color: var(--text-muted);
    }
    .nav__user strong { color: var(--text); }

    /* ── Buttons ──────────────────────────────────── */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: .55rem 1.3rem;
      font-size: .875rem;
      font-weight: 600;
      border: none;
      border-radius: var(--radius);
      cursor: pointer;
      transition: background .2s, transform .1s, box-shadow .2s;
    }
    .btn:active { transform: scale(.97); }
    .btn-primary {
      background: var(--accent);
      color: #fff;
    }
    .btn-primary:hover { background: var(--accent-hover); box-shadow: 0 0 20px rgba(99,102,241,.35); }
    .btn-danger {
      background: transparent;
      color: var(--danger);
      border: 1px solid var(--danger);
    }
    .btn-danger:hover { background: var(--danger); color: #fff; }
    .btn-ghost {
      background: transparent;
      color: var(--text-muted);
      border: 1px solid var(--border);
    }
    .btn-ghost:hover { border-color: var(--text-muted); color: var(--text); }

    /* ── Cards ────────────────────────────────────── */
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 2rem;
      box-shadow: var(--shadow);
    }

    /* ── Forms ────────────────────────────────────── */
    .form-group { margin-bottom: 1.25rem; }
    .form-group label {
      display: block;
      margin-bottom: .4rem;
      font-size: .85rem;
      font-weight: 500;
      color: var(--text-muted);
      letter-spacing: .02em;
    }
    .form-group input[type="text"],
    .form-group input[type="email"],
    .form-group input[type="password"] {
      width: 100%;
      padding: .7rem 1rem;
      font-size: .9rem;
      font-family: inherit;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      outline: none;
      transition: border-color .2s, box-shadow .2s;
    }
    .form-group input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(99,102,241,.15);
    }

    /* ── Alerts ───────────────────────────────────── */
    .alert {
      padding: .75rem 1rem;
      border-radius: var(--radius);
      font-size: .85rem;
      margin-bottom: 1.25rem;
    }
    .alert-error {
      background: rgba(244,63,94,.1);
      border: 1px solid rgba(244,63,94,.3);
      color: var(--danger);
    }
    .alert-success {
      background: rgba(16,185,129,.1);
      border: 1px solid rgba(16,185,129,.3);
      color: var(--success);
    }
    .alert-warning {
      background: rgba(245,158,11,.1);
      border: 1px solid rgba(245,158,11,.3);
      color: var(--warning);
    }

    /* ── Main Content ─────────────────────────────── */
    .main { flex: 1; padding: 2rem; max-width: 960px; margin: 0 auto; width: 100%; }

    /* ── Utilities ─────────────────────────────────── */
    .text-center { text-align: center; }
    .mb-1 { margin-bottom: .5rem; }
    .mb-2 { margin-bottom: 1rem; }
    .mt-2 { margin-top: 1rem; }

    /* ── Responsive ────────────────────────────────── */
    @media (max-width: 640px) {
      .nav { padding: 0 1rem; }
      .nav__links { margin-left: 1rem; gap: .75rem; }
      .main { padding: 1.25rem; }
      .card { padding: 1.25rem; }
    }
  </style>
</head>
<body>
  <% if (typeof user !== 'undefined' && user) { %>
  <nav class="nav" id="main-nav">
    <span class="nav__brand">AuthServer</span>
    <ul class="nav__links">
      <li><a href="/dashboard" class="<%= currentPage === 'dashboard' ? 'active' : '' %>" id="nav-dashboard">Dashboard</a></li>
      <li><a href="/settings"  class="<%= currentPage === 'settings'  ? 'active' : '' %>" id="nav-settings">Settings</a></li>
    </ul>
    <div class="nav__right">
      <span class="nav__user">Signed in as <strong><%= user.name %></strong></span>
      <form action="/logout" method="POST" style="display:inline;" id="logout-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-danger" id="logout-btn">Logout</button>
      </form>
    </div>
  </nav>
  <% } %>

  <main class="main">
    <%- body %>
  </main>
</body>
</html>
