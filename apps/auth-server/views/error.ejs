<% var body=` <div style="display:flex;align-items:center;justify-content:center;min-height:calc(100vh - 80px);">
    <div class="card text-center" style="max-width:460px;width:100%;">
        <div style="font-size:3rem;margin-bottom:1rem;">🚫</div>
        <h1 style="font-size:1.5rem;font-weight:700;margin-bottom:.5rem;">
            ${typeof title !== 'undefined' ? title : 'Error'}
        </h1>
        <p style="color:#8b8fa3;margin-bottom:1.5rem;">
            ${typeof message !== 'undefined' ? message : 'An unexpected error occurred.'}
        </p>
        <a href="/login" class="btn btn-primary" id="back-to-login">Back to Sign In</a>
    </div>
    </div>
    ` %>
    <%- include('layout') %>