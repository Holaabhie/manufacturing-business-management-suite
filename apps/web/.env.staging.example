# ==============================================================================
# IND-Manager Local Staging Environment Configuration Template
# ==============================================================================
# Copy this file to .env.staging.local (gitignored) and populate with your staging values.
# DO NOT commit .env.staging.local to git.
# ==============================================================================

# ─── Environment & Safety ─────────────────────────────────────────────────────
NODE_ENV=staging
ALLOW_SEED=1

# ─── MongoDB Database Connection ──────────────────────────────────────────────
# Staging database MUST end with an approved suffix: -staging, _staging, -dev, _dev, -local
# Example Local: mongodb://localhost:27017/ind-manager-staging
# Example Atlas Free: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ind-manager-staging?retryWrites=true&w=majority
MONGODB_URI=

# ─── NextAuth / Authentication ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Local URL (or your machine's LAN IP if testing from mobile on LAN, e.g. http://192.168.1.100:3000)
NEXTAUTH_URL=http://localhost:3000

# ─── Public Application URLs ──────────────────────────────────────────────────
# Used for SEO, absolute image URLs, and webhook callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Gemini AI Assistant & OCR ────────────────────────────────────────────────
GEMINI_API_KEY=
# Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# ─── Payment Gateway (Razorpay Sandbox / Test Mode) ───────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Email Dispatch (Resend Test / Staging Domain) ────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=staging@yourdomain.com

# ─── Low Memory Build Optimization ────────────────────────────────────────────
# Set to 1 if building on machines with <= 8GB RAM
LOW_MEM_BUILD=0
