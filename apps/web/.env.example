# ==============================================================================
# IND-Manager Web Environment Configuration (.env.example)
# ==============================================================================
# All variables discovered in apps/web audit. No values are committed here.
# Copy to .env.local for local development or configure in Vercel Project Settings.

# ------------------------------------------------------------------------------
# 1. REQUIRED IN PRODUCTION
# ------------------------------------------------------------------------------
# Primary MongoDB Connection URI (Strictly enforced by schema validation in production)
MONGODB_URI=
MONGODB_DB=

# Application & Auth URLs
NEXT_PUBLIC_APP_URL=
AUTH_URL=
NEXTAUTH_URL=

# NextAuth / Auth.js Encryption Secret (generate via: openssl rand -base64 32)
AUTH_SECRET=
NEXTAUTH_SECRET=

# Shared Secret for Vercel Cron endpoints (/api/cron/*, /api/auth/cleanup)
CRON_SECRET=

# Runtime environment (auto-set by Vercel)
NODE_ENV=


# ------------------------------------------------------------------------------
# 2. OPTIONAL IN PRODUCTION (Enabled per feature/integration)
# ------------------------------------------------------------------------------

# --- AI Assistant & Smart Reports (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# --- Google OAuth & One-Tap ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- GitHub OAuth ---
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Microsoft Entra ID (Azure AD) OAuth ---
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
AUTH_TRUST_HOST=

# --- Stripe Subscriptions & Billing ---
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Razorpay Standard Checkout & Subscriptions ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Email Notifications (Resend / SMTP) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- SMS & WhatsApp Notifications (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGES_API=

# --- Telegram Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Real-Time Order & Inventory WebSockets ---
NEXT_PUBLIC_WS_URL=

# --- Application Branding & Administration ---
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
PLATFORM_ADMIN_EMAILS=
LOG_LEVEL=
OTP_SECRET=
ENABLE_MULTI_TENANT=
REMEMBER_ME_DAYS=
SESSION_ONLY_DAYS=

# --- Headless PDF Browser Pool Settings ---
PDF_MAX_CONCURRENT_PAGES=
PDF_PAGE_TIMEOUT_MS=
PUPPETEER_EXECUTABLE_PATH=


# ------------------------------------------------------------------------------
# 3. NEVER IN PRODUCTION (Local Dev / Mock / Test Flags Only)
# ------------------------------------------------------------------------------
# DO NOT set these in Vercel or production environments.
DEV_MODE=
NEXT_PUBLIC_DEV_MODE=
DEV_MOCK_NOTIFICATIONS=
ENABLE_LOCAL_OTP_IN_PROD=
