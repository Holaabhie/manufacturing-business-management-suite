# ══════════════════════════════════════════════════════════════════
# IND Manager — Environment Variables
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ══════════════════════════════════════════════════════════════════

# ─── NextAuth.js v5 ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
AUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# ─── Google OAuth ─────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── MongoDB ──────────────────────────────────────────────────────
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ind_manager

# ─── MSG91 (OTP / SMS) ──────────────────────────────────────────
# https://msg91.com/
MSG91_API_KEY=your-msg91-api-key
MSG91_TEMPLATE_ID=your-otp-template-id
MSG91_SENDER_ID=INDMGR

# ─── Resend (Email) ──────────────────────────────────────────────
# https://resend.com/
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── App URL ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional: Microsoft Entra ID (Azure AD) ─────────────────────
# AZURE_AD_CLIENT_ID=your-azure-client-id
# AZURE_AD_CLIENT_SECRET=your-azure-client-secret
# AZURE_AD_TENANT_ID=your-tenant-id

# ─── Optional: Stripe Payments ───────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ─── AI Assistant Webhook ─────────────────────────────────────
# Webhook URL for the AI assistant (n8n / Make / custom endpoint).
# The assistant will not function until this is set.
AI_WEBHOOK_URL=

# ─── Optional: Dev Mode ──────────────────────────────────────────
# Set to "true" ONLY in local development to bypass auth
# DEV_MODE=false
