# ══════════════════════════════════════════════════════════════════
# IND Manager — Comprehensive Environment Configuration Template
# ══════════════════════════════════════════════════════════════════
# Copy this file to `.env.local` in `apps/web/` and populate your secrets.
# NEVER commit `.env.local` or raw API credentials to version control.
# ══════════════════════════════════════════════════════════════════

# ─── 1. Authentication & Session (NextAuth / Auth.js v5) ───────────
# Generate a secure 32-byte secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-32-byte-base64-secret-here
AUTH_SECRET=your-32-byte-base64-secret-here
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ─── 2. Single Sign-On (SSO / OAuth) ──────────────────────────────
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Microsoft Entra ID (Optional Azure AD integration)
AZURE_AD_CLIENT_ID=your-azure-client-id
AZURE_AD_CLIENT_SECRET=your-azure-client-secret
AZURE_AD_TENANT_ID=your-azure-tenant-id

# ─── 3. Database (MongoDB) ─────────────────────────────────────────
# Local MongoDB: mongodb://localhost:27017/ind_manager
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ind_manager?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ind_manager
MONGODB_DB=ind_manager

# ─── 4. Payment Gateways (Stripe & Razorpay) ──────────────────────
# Stripe (Global payments & subscriptions): https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PRO_PRICE_ID=price_your_stripe_pro_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Razorpay (India INR payments & UPI): https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── 5. Messaging & Notifications Channels ────────────────────────
# Twilio (WhatsApp & SMS notifications): https://console.twilio.com
# Set to placeholders or leave empty to automatically engage MockAdapter in dev mode
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VA_your_twilio_verify_service_sid
TWILIO_PHONE_NUMBER=+14155238886
TWILIO_MESSAGES_API=https://api.twilio.com/2010-04-01/Accounts/AC_your_twilio_account_sid/Messages.json

# MSG91 (India DLT SMS / OTP fallback): https://msg91.com/
MSG91_API_KEY=your_msg91_api_key
MSG91_TEMPLATE_ID=your_msg91_template_id
MSG91_SENDER_ID=INDMGR

# Resend (Transactional Email API): https://resend.com/
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# SMTP Nodemailer (Direct SMTP email delivery):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=IND Manager <noreply@indmanager.com>

# Telegram Bot (Team dispatch & alerts via @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─── 6. AI Assistant Engine (Google Gemini) ────────────────────────
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
AI_WEBHOOK_URL=

# ─── 7. Application Branding & Public URLs ────────────────────────
NEXT_PUBLIC_APP_NAME=IND Manager
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@indmanager.com

# ─── 8. Platform Administration & Super-Admin RBAC ────────────────
# Comma-separated list of platform super-admin emails (case-insensitive)
PLATFORM_ADMIN_EMAILS=admin@indmanager.com

# ─── 9. Local Development & Testing Bypasses ──────────────────────
# When DEV_MODE is true, feature gates and strict tier limits are bypassed
# MUST be false or removed in production
DEV_MODE=true
NEXT_PUBLIC_DEV_MODE=true

